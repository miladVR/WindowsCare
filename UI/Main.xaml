<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WindowsCare | مرکز نگهداری ویندوز" Width="1180" Height="900" MinWidth="980" MinHeight="780" WindowStartupLocation="CenterScreen" Background="#F2F5FA" FontFamily="Segoe UI, Tahoma" FontSize="14" FlowDirection="RightToLeft">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="13,9"/><Setter Property="Background" Value="#0F766E"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TextBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FlowDirection" Value="LeftToRight"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="7"/><Setter Property="FlowDirection" Value="LeftToRight"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Margin" Value="9,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="9,10"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
 </Window.Resources>
 <Grid Background="#F2F5FA">
  <Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="196"/></Grid.RowDefinitions>
  <Border Background="#13263F" Padding="24,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="مرکز نگهداری ویندوز" Foreground="White" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="بررسی • انتخاب • تأیید • اجرا • گزارش" Foreground="#A8CDD5" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" FlowDirection="LeftToRight"><TextBlock Text="WindowsCare" Foreground="White" FontSize="26" FontWeight="Bold"/><TextBlock Text="0.1.0  /  PREVIEW" Foreground="#67E8CF" FontSize="12" Margin="0,5,0,0"/></StackPanel></Grid></Border>
  <TabControl x:Name="Tabs" Grid.Row="1" Margin="16,12,16,4" Background="White" BorderBrush="#DCE4EF">
   <TabItem Header="سیستم"><StackPanel Margin="14"><TextBlock Text="وضعیت دستگاه و فضای ذخیره‌سازی را بررسی کنید. هیچ تعمیر یا نصبی با بازشدن برنامه شروع نمی‌شود." Margin="4,4,4,12"/><WrapPanel><Button x:Name="SystemInfo" Content="بررسی سیستم"/><Button x:Name="RestorePoint" Content="ساخت نقطه بازیابی"/><Button x:Name="OpenRestore" Content="تنظیمات System Protection"/><Button x:Name="OpenSettings" Content="تنظیمات ویندوز"/></WrapPanel><TextBlock Text="نقطه بازیابی جایگزین نسخه پشتیبان فایل‌های شخصی نیست. این نسخه برای Windows 10/11 x64 طراحی شده است." Foreground="#52657B" Margin="4,12"/></StackPanel></TabItem>
   <TabItem Header="آپدیت‌ها"><StackPanel Margin="14"><TextBlock Text="آپدیت‌ها از سرویس تنظیم‌شده ویندوز دریافت می‌شوند. موارد اختیاری و درایورها را آگاهانه انتخاب کنید." Margin="4,4,4,12"/><WrapPanel><Button x:Name="UpdateScan" Content="جست‌وجوی آپدیت ویندوز"/><Button x:Name="DriverScan" Content="جست‌وجوی آپدیت درایور"/><Button x:Name="UpdateInstall" Content="نصب موارد انتخاب‌شده"/><Button x:Name="ShowEula" Content="نمایش مجوز مورد جاری"/><Button x:Name="OpenUpdate" Content="Windows Update"/></WrapPanel><TextBlock Text="آپدیت‌های موفق تکرار نمی‌شوند؛ پس از Restart دوباره جست‌وجو کنید. برنامه خودکار Restart نمی‌کند." Foreground="#52657B" Margin="4,12"/></StackPanel></TabItem>
   <TabItem Header="آفیس"><StackPanel Margin="14"><TextBlock Text="نسخه متناسب با مجوز خود را انتخاب کنید. تنظیمات ابتدا قابل ذخیره و مشاهده است. تغییر Office از قبل نصب‌شده در این نسخه انجام نمی‌شود." Margin="4,0,4,5"/><WrapPanel><ComboBox x:Name="OfficeProduct" Width="340"/><ComboBox x:Name="OfficeBits" Width="80"><ComboBoxItem Content="64" IsSelected="True"/><ComboBoxItem Content="32"/></ComboBox><ComboBox x:Name="OfficeLanguage" Width="100"><ComboBoxItem Content="en-us" IsSelected="True"/><ComboBoxItem Content="fa-ir"/><ComboBoxItem Content="ar-sa"/></ComboBox></WrapPanel><WrapPanel FlowDirection="LeftToRight"><CheckBox x:Name="AppWord" Content="Word" IsChecked="True"/><CheckBox x:Name="AppExcel" Content="Excel" IsChecked="True"/><CheckBox x:Name="AppPowerPoint" Content="PowerPoint" IsChecked="True"/><CheckBox x:Name="AppOutlook" Content="Outlook"/><CheckBox x:Name="AppOneNote" Content="OneNote"/><CheckBox x:Name="AppAccess" Content="Access"/></WrapPanel><DockPanel><Button x:Name="PickOdt" DockPanel.Dock="Left" Content="انتخاب setup.exe"/><TextBox x:Name="OdtPath" ToolTip="اختیاری؛ اگر خالی باشد ابزار از Microsoft دریافت می‌شود."/></DockPanel><WrapPanel><Button x:Name="OfficeConfig" Content="ساخت فایل تنظیمات"/><Button x:Name="OfficeInstall" Content="نصب Office انتخابی"/><Button x:Name="OpenOdt" Content="دریافت رسمی ODT"/><Button x:Name="OpenOffice" Content="حساب و مجوز Office"/></WrapPanel></StackPanel></TabItem>
   <TabItem Header="امنیت"><StackPanel Margin="14"><WrapPanel><Button x:Name="SecurityInfo" Content="وضعیت امنیت"/><Button x:Name="DefenderUpdate" Content="آپدیت Defender"/><Button x:Name="DefenderQuick" Content="اسکن سریع"/><Button x:Name="DefenderFull" Content="اسکن کامل"/><Button x:Name="OpenSecurity" Content="Windows Security"/></WrapPanel><TextBlock Text="آنتی‌ویروس جایگزین: ابتدا نصب‌کننده را از سایت رسمی دریافت کنید. امضای ناشر بررسی می‌شود؛ وجود آنتی‌ویروس ثالث دیگر، نصب را متوقف می‌کند." Margin="4,8"/><DockPanel><ComboBox x:Name="AntivirusVendor" DockPanel.Dock="Right" Width="150"/><Button x:Name="OpenVendor" DockPanel.Dock="Left" Content="سایت رسمی"/><Button x:Name="PickAntivirus" DockPanel.Dock="Left" Content="انتخاب EXE"/><TextBox x:Name="AntivirusPath"/></DockPanel><Button x:Name="AntivirusInstall" Content="اجرای نصب‌کننده تأییدشده" HorizontalAlignment="Right"/></StackPanel></TabItem>
   <TabItem Header="تعمیر ویندوز"><StackPanel Margin="14"><TextBlock Text="هر ابزار برای یک مشکل مشخص است. پیش از تغییرات حساس، وضعیت برق، فضای آزاد و Restart بررسی می‌شود." Margin="4,4,4,12"/><WrapPanel><Button x:Name="WindowsCheck" Content="بررسی DISM / SFC"/><Button x:Name="WindowsRepair" Content="تعمیر DISM / SFC"/><Button x:Name="NetworkInfo" Content="عیب‌یابی شبکه"/><Button x:Name="NetworkRepair" Content="بازنشانی DNS / Winsock"/></WrapPanel><WrapPanel><Button x:Name="UpdateRepair" Content="بازراه‌اندازی سرویس آپدیت"/><Button x:Name="AudioRepair" Content="بازراه‌اندازی سرویس صدا"/><Button x:Name="PrintRepair" Content="بازراه‌اندازی سرویس چاپ"/><Button x:Name="OpenTroubleshoot" Content="عیب‌یاب‌های ویندوز"/></WrapPanel><TextBlock Text="تعمیر همه خطاها تضمین نمی‌شود. بازنشانی شبکه ممکن است اتصال VPN را مختل کند؛ راه‌اندازی مجدد چاپ، چاپ جاری را متوقف می‌کند." Foreground="#52657B" Margin="4,8"/></StackPanel></TabItem>
   <TabItem Header="دیسک"><StackPanel Margin="14"><TextBlock Text="سلامت فیزیکی، فایل‌سیستم و بهینه‌سازی سه موضوع متفاوت‌اند. روی دیسک مشکوک ابتدا از اطلاعات پشتیبان بگیرید." Margin="4,4,4,12"/><WrapPanel><TextBlock Text="درایو:"/><ComboBox x:Name="Drive" Width="80"/><Button x:Name="DiskInfo" Content="سلامت و SMART"/><Button x:Name="DiskScan" Content="اسکن NTFS"/><Button x:Name="DiskOptimize" Content="بهینه‌سازی متناسب با دیسک"/><Button x:Name="DiskRepair" Content="تعمیر آفلاین درایو داده"/></WrapPanel><TextBlock Text="بهینه‌سازی را خود ویندوز مطابق نوع ذخیره‌ساز انجام می‌دهد. تعمیر آفلاین درایو داده دسترسی برنامه‌ها را قطع می‌کند؛ درایو ویندوز از این عملیات مستثنا است." Foreground="#52657B" Margin="4,12"/></StackPanel></TabItem>
   <TabItem Header="پاکسازی"><StackPanel Margin="14"><DockPanel><Button x:Name="PickFolder" DockPanel.Dock="Left" Content="انتخاب پوشه"/><TextBox x:Name="ScanRoot"/></DockPanel><WrapPanel><TextBlock Text="حداقل حجم (MB):"/><TextBox x:Name="MinSize" Text="500" Width="90"/><Button x:Name="LargeFiles" Content="فایل‌های حجیم"/><Button x:Name="DuplicateFiles" Content="فایل‌های تکراری با SHA256"/><Button x:Name="TempFiles" Content="فایل‌های موقت قدیمی"/><Button x:Name="RecycleFiles" Content="انتقال انتخاب‌ها به سطل بازیافت"/></WrapPanel><TextBlock Text="حجیم یا تکراری بودن به معنی بی‌مصرف بودن نیست. برای هر گروه تکراری حداقل یک نسخه حفظ می‌شود. فایل‌های ابری، پیوندها و مسیرهای سیستمی کنار گذاشته می‌شوند." Foreground="#52657B" Margin="4,8"/></StackPanel></TabItem>
   <TabItem Header="درایورها"><StackPanel Margin="14"><WrapPanel><Button x:Name="DriverList" Content="فهرست و خطای دستگاه‌ها"/><Button x:Name="DriverBackup" Content="ساخت پشتیبان ZIP"/><Button x:Name="OpenDeviceManager" Content="Device Manager"/></WrapPanel><DockPanel><Button x:Name="PickArchive" DockPanel.Dock="Left" Content="انتخاب ZIP پشتیبان"/><TextBox x:Name="DriverArchive"/></DockPanel><WrapPanel><Button x:Name="DriverInspect" Content="بررسی بسته"/><Button x:Name="DriverRestore" Content="نصب بسته بررسی‌شده"/></WrapPanel><TextBlock Text="فقط بسته‌های ثالث قابل‌صدور ذخیره می‌شوند. نصب روی سیستم جدید به معماری و سخت‌افزار منطبق وابسته است؛ نصب همه بسته‌ها تضمین نمی‌شود." Foreground="#52657B" Margin="4,8"/></StackPanel></TabItem>
   <TabItem Header="گزارش و راهنما"><StackPanel Margin="14"><TextBlock Text="گزارش هر عملیات به شکل HTML، JSON، CSV و متن روی همین دستگاه ذخیره می‌شود. گزارش‌ها ممکن است شامل مسیر فایل‌های شخصی باشند؛ پیش از اشتراک‌گذاری بررسی کنید." Margin="4,4,4,12"/><WrapPanel><Button x:Name="OpenHistory" Content="پوشه همه گزارش‌ها"/><Button x:Name="OpenReport" Content="گزارش HTML آخرین عملیات"/><Button x:Name="OpenGuide" Content="راهنمای فارسی"/></WrapPanel><TextBlock Text="این نسخه پیش‌نمایش است. ادامه بعد از Restart با بررسی مجدد وضعیت انجام می‌شود؛ تعمیر یا نصب نیمه‌تمام خودکار تکرار نمی‌شود. ارسال اطلاعات و زمان‌بندی پس‌زمینه فعال نیست." Foreground="#52657B" Margin="4,12"/></StackPanel></TabItem>
  </TabControl>
  <Grid Grid.Row="2" Margin="16,6"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,6"><TextBlock x:Name="ResultTitle" Text="نتایج — یک بررسی را از بخش‌های بالا انتخاب کنید" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Left" Orientation="Horizontal"><Button x:Name="SelectAll" Content="انتخاب همه" Padding="10,4"/><Button x:Name="SelectNone" Content="لغو انتخاب" Padding="10,4"/><Button x:Name="ShowDetails" Content="جزئیات مورد جاری" Padding="10,4"/></StackPanel></DockPanel><DataGrid x:Name="Results" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E7EDF5" Background="White" BorderBrush="#DCE4EF" RowHeight="34" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridCheckBoxColumn Header="انتخاب" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="65"/><DataGridTextColumn Header="نام" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/><DataGridTextColumn Header="وضعیت / جزئیات" Binding="{Binding Detail}" Width="3*" IsReadOnly="True"/><DataGridTextColumn Header="مسیر" Binding="{Binding Path}" Width="3*" IsReadOnly="True"/></DataGrid.Columns></DataGrid></Grid>
  <Border Grid.Row="3" Background="White" BorderBrush="#DCE4EF" BorderThickness="0,1,0,0" Padding="16,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><Button x:Name="Cancel" DockPanel.Dock="Left" Content="توقف در مرز امن" IsEnabled="False" Padding="12,5"/><CheckBox x:Name="AllowNoRestore" Content="اگر نقطه بازیابی ساخته نشد، با مسئولیت من و با داشتن پشتیبان ادامه بده"/></DockPanel><TextBlock x:Name="Status" Grid.Row="1" Text="آماده" Foreground="#0F766E" Margin="4,2"/><ProgressBar x:Name="Progress" Grid.Row="2" Height="4" Margin="0,5" Minimum="0" Maximum="100"/><TextBox x:Name="Log" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F5F7FB" BorderThickness="0"/></Grid></Border>
 </Grid>
</Window>
